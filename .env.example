# ======================================================================
# Required
# ======================================================================

# <-------------- General -------------->
SECRET_KEY=----------------------
DEBUG=True
IS_PRODUCTION=False


# <-------------- URLs -------------->
FRONT_URL='http://localhost:3000'
CSRF_TRUSTED_ORIGINS='http://localhost:8000'
ALLOWED_HOSTS='localhost:8000'
CORS_ALLOWED_URLS='http://localhost:3000,http://localhost:8000'


# <-------------- Database -------------->
# Engines: sqlite3, postgresql(5432), mysql(3306), oracle(1521)
DB_ENGINE='sqlite3'
DB_USER='DB_USER'
DB_PASSWORD='DB_PASSWORD'
DB_HOST='DB_HOST'   # 'db' si usás la DB dockerizada
DB_PORT='DB_PORT'
DB_NAME='DB_NAME'


# <-------------- Email -------------->
# Providers: console, aws, smtp
EMAIL_PROVIDER='console'
EMAIL_HOST='Big-Host'
EMAIL_HOST_USER=project@company.com
EMAIL_HOST_PASSWORD='Password'
EMAIL_USE_TLS=True
EMAIL_PORT=587
DEFAULT_FROM_EMAIL='project@linkchar.com'


# ======================================================================
# Optional
# ======================================================================

# <-------------- AWS / S3 (storage) -------------->
USE_S3=False
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_STORAGE_BUCKET_NAME=''


# <-------------- Sentry -------------->
SENTRY_DSN=''


# <-------------- Google OAuth (allauth) -------------->
# CLIENT_ID y CLIENT_SECRET se configuran via Django admin (SocialApp model),
# acá sólo se persiste la URL de callback que consume el view GoogleLogin.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
